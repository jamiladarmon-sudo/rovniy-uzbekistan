<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Chipa Chips Tesla</title>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet">

<style>
* {
  box-sizing: border-box;
  font-family: 'Inter', sans-serif;
}

body {
  margin: 0;
  min-height: 100vh;
  background: radial-gradient(circle at top, #0b1220, #03060f);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.container {
  width: 100%;
  max-width: 420px;
  padding: 40px 22px;
  text-align: center;
}

/* BRAND */
.brand h1 {
  font-size: 26px;
  font-weight: 700;
  letter-spacing: 0.5px;
  margin-bottom: 8px;
}

.brand p {
  font-size: 14px;
  opacity: 0.8;
  line-height: 1.5;
}

/* GLASS CARD */
.card {
  margin-top: 36px;
  padding: 28px 20px;
  border-radius: 22px;
  background: rgba(255,255,255,0.08);
  backdrop-filter: blur(18px);
  box-shadow: 0 10px 40px rgba(0,0,0,0.6);
}

/* MAIN BUTTON */
.main-btn {
  display: block;
  width: 100%;
  padding: 18px;
  margin-bottom: 14px;
  font-size: 16px;
  font-weight: 700;
  color: #0b0f1a;
  text-decoration: none;
  border-radius: 16px;
  background: linear-gradient(135deg, #00ff9c, #00d4ff);
  box-shadow: 0 0 22px rgba(0,255,200,0.45);
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0% { box-shadow: 0 0 22px rgba(0,255,200,0.4); }
  50% { box-shadow: 0 0 38px rgba(0,255,200,0.75); }
  100% { box-shadow: 0 0 22px rgba(0,255,200,0.4); }
}

.main-btn:hover {
  transform: scale(1.02);
}

/* SUBTEXT */
.subtext {
  font-size: 13px;
  opacity: 0.8;
  margin-bottom: 26px;
}

/* SECOND BUTTON */
.second-btn {
  display: block;
  width: 100%;
  padding: 16px;
  font-size: 15px;
  font-weight: 600;
  color: #ffffff;
  text-decoration: none;
  border-radius: 14px;
  background: rgba(255,255,255,0.12);
  box-shadow: 0 8px 26px rgba(0,0,0,0.5);
}

.second-btn:hover {
  background: rgba(255,255,255,0.18);
}

/* OPERATOR TEXT */
.operator-text {
  font-size: 13px;
  opacity: 0.75;
  margin-top: 10px;
  line-height: 1.4;
}

/* LANGUAGE */
.lang {
  margin-top: 36px;
  font-size: 14px;
  opacity: 0.85;
}
.lang span {
  margin: 0 6px;
}
</style>
</head>

<body>
<div class="container">

  <div class="brand">
    <h1>CHIPA CHIPS TESLA ⚡️</h1>
    <p>
      Официальная площадка<br>
      «Ровный Узбекистан» 🇺🇿
    </p>
  </div>

  <div class="card">
    <a href="https://t.me/chupachips_uz_bot?start=ads" class="main-btn">
      🚀 ПЕРЕЙТИ В TELEGRAM-БОТ
    </a>

    <div class="subtext">
      Прикоп / Магнит • Пробники • Чат
    </div>

    <a href="https://t.me/tvc24_tash" class="second-btn">
      💬 Связаться с оператором
    </a>

    <div class="operator-text">
      Помощь • Вопросы • Работа 24/7<br>
      От 1000$ в неделю
    </div>
  </div>

  <div class="lang">
    🇷🇺 Русский <span>|</span> 🇺🇿 O‘zbekcha
  </div>

</div>
</body>
</html>
